@model ABCRetail.Models.OrderText

@{
    ViewData["Title"] = "Process Order";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <h1 class="page-title">Process Order</h1>
        <p class="text-muted mb-4">Submit an order to Azure Queue Storage</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <i class="bi bi-cart-check me-2"></i> Order Details
            </div>
            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div class="mb-3">
                        <label asp-for="OrderId" class="form-label">Order ID</label>
                        <input asp-for="OrderId"
                               class="form-control"
                               placeholder="e.g. ORD001"
                               required />
                        <span asp-validation-for="OrderId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label">Customer Name</label>
                        <input asp-for="CustomerName"
                               class="form-control"
                               placeholder="Enter customer name"
                               required />
                        <span asp-validation-for="CustomerName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProductName" class="form-label">Product</label>
                        <input asp-for="ProductName"
                               class="form-control"
                               placeholder="Enter product name"
                               required />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Quantity" class="form-label">Quantity</label>
                        <input asp-for="Quantity"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="1"
                               required />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-orange">
                            <i class="bi bi-send-check me-1"></i> Process Order
                        </button>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>
@model ABCRetail.Models.Customer

@{
    ViewData["Title"] = "Add Customer";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <h1 class="page-title">Add Customer</h1>

        <div class="card">
            <div class="card-header">
                <i class="bi bi-person-plus me-2"></i> Customer Details
            </div>
            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Customer Name</label>
                        <input asp-for="Name" class="form-control" required placeholder="Enter full name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" required placeholder="example@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" required placeholder="e.g. 082 123 4567" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-orange">
                            <i class="bi bi-check-lg me-1"></i> Save Customer
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@{
    ViewData["Title"] = "Upload Product Image";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <h1 class="page-title">Upload Product Image</h1>
        <p class="text-muted mb-4">Upload a product image to Azure Blob Storage</p>

        <div class="card">
            <div class="card-header">
                <i class="bi bi-cloud-upload me-2"></i> Select Image
            </div>
            <div class="card-body">

                <form asp-action="Upload" method="post" enctype="multipart/form-data">

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label class="form-label">Choose Image File</label>
                        <input type="file"
                               name="file"
                               class="form-control"
                               accept="image/*"
                               required />
                        <div class="form-text text-muted">
                            Supported formats: JPG, PNG, GIF, WEBP
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-orange">
                            <i class="bi bi-upload me-1"></i> Upload Image
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>
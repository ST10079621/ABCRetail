@model IEnumerable<string>

@{
    ViewData["Title"] = "Product Images";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">Product Images</h1>
        <p class="text-muted mb-0">Images stored in Azure Blob Storage</p>
    </div>

    <a asp-action="Upload" class="btn btn-orange">
        <i class="bi bi-cloud-upload me-1"></i> Upload Image
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary text-center py-4">
        <i class="bi bi-image fs-1 d-block mb-2 opacity-50"></i>
        No images have been uploaded yet.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var image in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100">
                    <img src="@Url.Action("Download", "Images", new { fileName = image })"
                         class="card-img-top"
                         style="height: 220px; object-fit: cover;"
                         alt="Product image" />

                    <div class="card-body d-flex flex-column">
                        <p class="small text-muted text-truncate mb-3" title="@image">
                            @image
                        </p>

                        <div class="d-flex gap-2 mt-auto">
                            <a href="@Url.Action("Download", "Images", new { fileName = image })"
                                   class="btn btn-sm btn-outline-orange flex-fill">
                                <i class="bi bi-download"></i> Download
                            </a>

                            <form asp-action="Delete" method="post" class="flex-fill">
                                <input type="hidden" name="fileName" value="@image" />
                                <button type="submit" class="btn btn-sm btn-danger w-100"
                                        onclick="return confirm('Are you sure you want to delete this image?');">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
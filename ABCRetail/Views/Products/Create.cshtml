@model ABCRetail.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <h1 class="page-title">Add Product</h1>

        <div class="card">
            <div class="card-header">
                <i class="bi bi-box-seam me-2"></i> Product Details
            </div>
            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div class="mb-3">
                        <label asp-for="ProductName" class="form-label">Product Name</label>
                        <input asp-for="ProductName"
                               class="form-control"
                               placeholder="Enter product name"
                               required />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category" class="form-label">Category</label>
                        <input asp-for="Category"
                               class="form-control"
                               placeholder="e.g. Electronics, Clothing"
                               required />
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label">Price (R)</label>
                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="0.00"
                               required />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Quantity" class="form-label">Quantity</label>
                        <input asp-for="Quantity"
                               type="number"
                               min="0"
                               class="form-control"
                               placeholder="0"
                               required />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-orange">
                            <i class="bi bi-check-lg me-1"></i> Save Product
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>
@model IEnumerable<ABCRetail.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">Products</h1>

    <a asp-action="Create" class="btn btn-orange">
        <i class="bi bi-plus-lg me-1"></i> Add Product
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.ProductName</td>
                            <td>
                                <span class="badge bg-secondary">@product.Category</span>
                            </td>
                            <td class="text-orange fw-semibold">
                                R @product.Price.ToString("N2")
                            </td>
                            <td>@product.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary mt-3 text-center">
        No products found. Click <strong>Add Product</strong> to create one.
    </div>
}
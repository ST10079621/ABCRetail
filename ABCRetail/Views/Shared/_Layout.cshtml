<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Retail</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            :root {
                --bg-dark: #0d0d0d;
                --bg-card: #1a1a1a;
                --bg-navbar: #111111;
                --orange: #ff6b00;
                --orange-hover: #e55f00;
                --red: #e63939;
                --grey: #888888;
                --light-grey: #cccccc;
            }

            html, body {
                height: 100%;
                margin: 0;
            }

            body {
                background-color: var(--bg-dark);
                color: #ffffff;
                font-family: 'Segoe UI', system-ui, sans-serif;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            /* Navbar */
            .navbar {
                background-color: var(--bg-navbar) !important;
                border-bottom: 2px solid #222;
                padding: 0.8rem 0;
            }

            .navbar-brand {
                font-weight: 700;
                font-size: 1.5rem;
                color: var(--orange) !important;
                letter-spacing: 0.5px;
            }

                .navbar-brand:hover {
                    color: #ff8533 !important;
                }

            .nav-link {
                color: #dddddd !important;
                font-weight: 500;
                margin: 0 6px;
                border-radius: 6px;
                transition: all 0.2s;
            }

                .nav-link:hover,
                .nav-link.active {
                    color: var(--orange) !important;
                    background-color: rgba(255, 107, 0, 0.1);
                }

            /* Main content pushes footer down */
            .main-content {
                flex: 1 0 auto;
            }

            .container {
                max-width: 1200px;
            }

            /* Cards */
            .card {
                background-color: var(--bg-card);
                border: 1px solid #2a2a2a;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
            }

            .card-header {
                background-color: #222;
                border-bottom: 1px solid #333;
                font-weight: 600;
                color: var(--orange);
            }

            /* Buttons */
            .btn-orange {
                background-color: var(--orange);
                color: white;
                border: none;
                font-weight: 600;
            }

                .btn-orange:hover {
                    background-color: var(--orange-hover);
                    color: white;
                }

            .btn-outline-orange {
                color: var(--orange);
                border-color: var(--orange);
            }

                .btn-outline-orange:hover {
                    background-color: var(--orange);
                    color: white;
                }

            .btn-danger {
                background-color: var(--red);
                border-color: var(--red);
            }

            /* Tables */
            .table {
                color: #eee;
                --bs-table-bg: transparent;
                --bs-table-striped-bg: rgba(255, 255, 255, 0.03);
                --bs-table-hover-bg: rgba(255, 107, 0, 0.08);
            }

                .table thead th {
                    background-color: #222;
                    color: var(--orange);
                    border-color: #333;
                    font-weight: 600;
                }

                .table td, .table th {
                    border-color: #333;
                    vertical-align: middle;
                }

            /* Forms */
            .form-control, .form-select {
                background-color: #252525;
                border: 1px solid #444;
                color: white;
            }

                .form-control:focus, .form-select:focus {
                    background-color: #2a2a2a;
                    border-color: var(--orange);
                    color: white;
                    box-shadow: 0 0 0 0.2rem rgba(255, 107, 0, 0.25);
                }

            .form-label {
                color: var(--light-grey);
                font-weight: 500;
            }

            /* Footer - always at bottom */
            .footer {
                flex-shrink: 0;
                background-color: #111;
                border-top: 1px solid #222;
                color: var(--grey);
                padding: 1.2rem 0;
                margin-top: auto;
            }

            /* Extra polish */
            .page-title {
                color: white;
                font-weight: 700;
                margin-bottom: 1.5rem;
                border-left: 5px solid var(--orange);
                padding-left: 15px;
            }

            .alert-success {
                background-color: rgba(40, 167, 69, 0.15);
                border-color: #28a745;
                color: #7dcea0;
            }

            .alert-danger {
                background-color: rgba(230, 57, 57, 0.15);
                border-color: var(--red);
                color: #f5a9a9;
            }

        /* Tables */
        .table {
            width: 100%;
            color: #eeeeee;
            background-color: var(--bg-card);
            border: 1px solid #2a2a2a;
            border-radius: 10px;
            overflow: hidden;
            --bs-table-bg: var(--bg-card);
            --bs-table-color: #eeeeee;
            --bs-table-striped-bg: #202020;
            --bs-table-striped-color: #ffffff;
            --bs-table-hover-bg: rgba(255, 107, 0, 0.10);
            --bs-table-hover-color: #ffffff;
            margin-bottom: 0;
        }

            .table thead th {
                background-color: #222222 !important;
                color: var(--orange) !important;
                border-color: #333333 !important;
                font-weight: 600;
                padding: 14px 16px;
            }

            .table tbody td {
                background-color: var(--bg-card) !important;
                color: #eeeeee !important;
                border-color: #2f2f2f !important;
                padding: 14px 16px;
            }

            .table tbody tr:nth-child(even) td {
                background-color: #202020 !important;
            }

            .table tbody tr:hover td {
                background-color: rgba(255, 107, 0, 0.10) !important;
                color: #ffffff !important;
            }

        /* Table container */
        .table-responsive {
            background-color: var(--bg-card);
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
            overflow: hidden;
        }

        /* Page headings */
        h1 {
            color: #ffffff;
            font-weight: 700;
        }

        .text-muted {
            color: #999999 !important;
        }

        /* Action buttons */
        .table .btn {
            font-weight: 600;
            border-radius: 6px;
            padding: 6px 12px;
        }

        .table .btn-warning {
            color: #111111;
            font-weight: 600;
        }

        .table .btn-danger {
            background-color: var(--red);
            border-color: var(--red);
        }

        /* Back/dashboard buttons */
        .btn-secondary {
            background-color: #333333;
            border-color: #444444;
            color: #ffffff;
        }

            .btn-secondary:hover {
                background-color: #444444;
                border-color: #555555;
                color: #ffffff;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop me-2"></i>ABC Retail
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">

                        <!-- HOME - EVERYONE -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>


                        <!-- ========================= -->
                        <!-- CUSTOMER NAVIGATION       -->
                        <!-- ========================= -->
                        @if (User.Identity?.IsAuthenticated == true &&
                                                User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Products"
                                   asp-action="Index">
                                    <i class="bi bi-box-seam me-1"></i> Products
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Orders"
                                   asp-action="Create">
                                    <i class="bi bi-cart-check me-1"></i> My Orders
                                </a>
                            </li>
                        }


                        <!-- ========================= -->
                        <!-- ADMIN NAVIGATION           -->
                        <!-- ========================= -->
                        @if (User.Identity?.IsAuthenticated == true &&
                                                User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Products"
                                   asp-action="Index">
                                    <i class="bi bi-box-seam me-1"></i> Products
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Customers"
                                   asp-action="Index">
                                    <i class="bi bi-people me-1"></i> Customers
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Images"
                                   asp-action="Index">
                                    <i class="bi bi-images me-1"></i> Images
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Orders"
                                   asp-action="Create">
                                    <i class="bi bi-cart-check me-1"></i> Orders
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Stock"
                                   asp-action="Update">
                                    <i class="bi bi-boxes me-1"></i> Stock
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Logs"
                                   asp-action="Index">
                                    <i class="bi bi-journal-text me-1"></i> Logs
                                </a>
                            </li>
                        }


                        <!-- ========================= -->
                        <!-- LOGIN / LOGOUT             -->
                        <!-- ========================= -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item ms-2">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-orange">
                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Logout
                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- This is the key part for sticky footer -->
    <div class="main-content">
        <div class="container mt-4">
            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer">
        <div class="container text-center">
            &copy; 2026 ABC Retail • Azure Storage Solution
            <span class="mx-2">|</span>
            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none" style="color: var(--orange);">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
